<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cfanalyzer.controller.UserManagementController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <children>
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <children>
                <TextField fx:id="handleTextField" promptText="Nhập handle Codeforces" prefWidth="200.0" />
                <Button mnemonicParsing="false" onAction="#handleAddUser" text="Thêm nick" />
                <Button mnemonicParsing="false" onAction="#handleRefresh" text="Làm mới" />
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#handleDeleteUser" text="Xóa nick" style="-fx-base: #ffcccc;" />
            </children>
        </HBox>
        <TableView fx:id="userTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="idColumn" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="handleColumn" prefWidth="120.0" text="Handle" />
                <TableColumn fx:id="ratingColumn" prefWidth="80.0" text="Rating" />
                <TableColumn fx:id="rankColumn" prefWidth="120.0" text="Rank" />
                <TableColumn fx:id="lastCrawledColumn" prefWidth="150.0" text="Lần crawl cuối" />
                <TableColumn fx:id="totalSolvedColumn" prefWidth="100.0" text="Đã giải" />
                <TableColumn fx:id="statusColumn" prefWidth="80.0" text="Trạng thái" />
            </columns>
        </TableView>
    </children>
</VBox>

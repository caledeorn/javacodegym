<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cfanalyzer.controller.AnalysisController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <children>
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <children>
                <Button mnemonicParsing="false" onAction="#handleAnalyzeSelected" text="Phân tích bài đã chọn" style="-fx-base: #a6e22e;" />
                <Button mnemonicParsing="false" onAction="#handleRefresh" text="Làm mới" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="statusLabel" text="Sẵn sàng" />
            </children>
        </HBox>
        <TableView fx:id="submissionTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="subIdColumn" prefWidth="80.0" text="ID" />
                <TableColumn fx:id="userIdSubColumn" prefWidth="80.0" text="User ID" />
                <TableColumn fx:id="problemColumn" prefWidth="200.0" text="Bài tập" />
                <TableColumn fx:id="verdictColumn" prefWidth="100.0" text="Verdict" />
                <TableColumn fx:id="langColumn" prefWidth="120.0" text="Ngôn ngữ" />
                <TableColumn fx:id="analyzedColumn" prefWidth="100.0" text="Đã phân tích" />
                <TableColumn fx:id="submittedAtColumn" prefWidth="150.0" text="Thời gian nộp" />
            </columns>
        </TableView>
        <VBox spacing="5.0" VBox.vgrow="ALWAYS">
            <children>
                <TabPane fx:id="detailTabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                    <tabs>
                        <Tab text="Kết quả phân tích AI">
                            <content>
                                <TextArea fx:id="analysisDetailArea" editable="false" wrapText="true" />
                            </content>
                        </Tab>
                        <Tab text="Mã nguồn (Source Code)">
                            <content>
                                <TextArea fx:id="sourceCodeArea" editable="false" wrapText="true" style="-fx-font-family: 'Consolas', monospace; -fx-font-size: 12px;" />
                            </content>
                        </Tab>
                    </tabs>
                </TabPane>
            </children>
        </VBox>
    </children>
</VBox>
